generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id                  String          @id @default(cuid())
  title               String
  company             String
  companyLogoUrl      String?
  location            String
  jobType             String
  category            String
  description         String
  applyLink           String
  featured            Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  salaryMax           Int?
  salaryMin           Int?
  salaryPeriod        String?         @default("month")
  closingDate         DateTime?
  placementType       String          @default("Local")
  sourceUrl           String?         @unique
  sourceName          String?
  reviewStatus        JobReviewStatus @default(APPROVED)
  importedAt          DateTime?
  rejectionReason     String?
  city                String?
  minRequirements     String?
  keyResponsibilities String?

  @@index([reviewStatus, closingDate])
  @@index([city])
}

model Bursary {
  id              String    @id @default(cuid())
  title           String
  provider        String
  fieldOfStudy    String?
  description     String
  closingDate     DateTime?
  applyLink       String
  featured        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  providerLogoUrl String?
}

model BlogPost {
  id              String   @id @default(cuid())
  title           String
  excerpt         String?
  content         String
  coverImageUrl   String?
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  featured        Boolean  @default(false)
  metaDescription String?
  metaTitle       String?
  slug            String  @unique
}

model Tender {
  id          String    @id @default(cuid())
  title       String
  issuer      String
  reference   String?
  location    String
  closingDate DateTime?
  applyUrl    String
  description String?
  createdAt   DateTime  @default(now())
}

enum JobReviewStatus {
  PENDING
  APPROVED
  REJECTED
}
